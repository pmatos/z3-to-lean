(declare-fun b () Int)
(declare-fun a () Int)
(define-const $7 Bool (= a b))
(assume $7)
(declare-fun c () Int)
(define-const $9 Bool (= b c))
(assume $9)
(define-const $10 Bool (= a c))
(assume (not $10))
(declare-fun euf (Bool Bool Bool) Proof)
(define-const $11 Bool (not $10))
